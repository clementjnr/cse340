<%- include("partials/header", { title }) %>

<section class="hero">
    <div class="hero-content">
        <p class="eyebrow">Community • Service • Impact</p>

        <h1>Make a Difference in Your Community</h1>

        <p>
            Discover organizations, service projects, and opportunities
            that help make our communities stronger.
        </p>

        <div class="hero-buttons">
            <a class="button" href="/organizations">
                View Organizations
            </a>

            <a class="button button-secondary" href="/service-projects">
                Explore Projects
            </a>
        </div>
    </div>
</section>

<section class="section">
    <h2>What We Provide</h2>

    <div class="card-grid">

        <article class="card">
            <img
                src="/images/organization.jpg"
                alt="People working together in a community organization"
                width="800"
                height="500"
            >

            <h3>Organizations</h3>

            <p>
                Learn about organizations that are actively serving
                and supporting their communities.
            </p>

            <a href="/organizations">View Organizations</a>
        </article>

        <article class="card">
            <img
                src="/images/service-project.jpg"
                alt="Volunteers participating in a service project"
                width="800"
                height="500"
            >

            <h3>Service Projects</h3>

            <p>
                Find meaningful projects where individuals can give
                their time and talents.
            </p>

            <a href="/service-projects">View Projects</a>
        </article>

        <article class="card">
            <img
                src="/images/community.jpg"
                alt="Community members helping one another"
                width="800"
                height="500"
            >

            <h3>Categories</h3>

            <p>
                Browse service opportunities according to their
                areas of focus.
            </p>

            <a href="/categories">View Categories</a>
        </article>

    </div>
</section>

<section class="section highlight">
    <h2>Small Actions Create Big Change</h2>

    <p>
        Whether you volunteer your time, support an organization,
        or participate in a local project, every contribution matters.
    </p>
</section>

<%- include("partials/footer") %>
