<%- include("partials/header", { title }) %>

<section class="page-heading">
    <p class="eyebrow">Get Involved</p>

    <h1>Community Organizations</h1>

    <p>
        Explore organizations that provide valuable services
        and support to people in our communities.
    </p>
</section>

<section class="card-grid">

    <% if (organizations.length > 0) { %>

        <% organizations.forEach((organization) => { %>

            <article class="card">

                <img
                    src="/images/organization.jfif"
                    alt="Volunteers working together in a community organization"
                    width="800"
                    height="500"
                >

                <h2><%= organization.name %></h2>

                <p>
                    <%= organization.description %>
                </p>

                <p>
                    <strong>Location:</strong>
                    <%= organization.location %>
                </p>

            </article>

        <% }) %>

    <% } else { %>

        <p>No organizations are available at this time.</p>

    <% } %>

</section>

<%- include("partials/footer") %>
