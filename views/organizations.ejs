            width="800"
            height="500"
        >

        <h2>Hope Foundation</h2>

        <p>
            Supports families and individuals through educational,
            social, and community programs.
        </p>

        <p><strong>Focus:</strong> Family and Education</p>
    </article>

    <article class="card">
        <img
            src="/images/service-project.jfif"
            alt="Volunteers participating in service"
            width="800"
            height="500"
        >

