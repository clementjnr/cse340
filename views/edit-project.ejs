<%- include("partials/header") %>

<main>

  <h1>Edit Service Project</h1>

  <form
    action="/edit-project/<%= project.project_id %>"
    method="POST"
  >

    <label for="organization_id">
      Organization
    </label>

    <select
      id="organization_id"
      name="organization_id"
      required
    >

      <option value="">
        Select an organization
      </option>

      <% organizations.forEach(organization => { %>

        <option
          value="<%= organization.organization_id %>"
          <%= Number(organization.organization_id) === Number(project.organization_id)
            ? "selected"
            : "" %>
        >
          <%= organization.name %>
        </option>

      <% }) %>

    </select>

    <label for="title">
      Project Title
    </label>

    <input
      type="text"
      id="title"
      name="title"
      value="<%= project.title || "" %>"
      required
      maxlength="100"
    >

    <label for="description">
      Description
    </label>

    <textarea
      id="description"
      name="description"
    ><%= project.description || "" %></textarea>

    <label for="location">
      Location
    </label>

    <input
      type="text"
      id="location"
      name="location"
      value="<%= project.location || "" %>"
    >

    <label for="project_date">
      Project Date
    </label>

    <input
      type="date"
      id="project_date"
      name="project_date"
      value="<%= project.project_date ? String(project.project_date).slice(0, 10) : "" %>"
      required
    >

    <button type="submit">
      Update Service Project
    </button>

    <a href="/projects/<%= project.project_id %>">
      Cancel
    </a>

  </form>

</main>

<%- include("partials/footer") %>