<label for="name">
  Organization Name
</label>

<input
  type="text"
  id="name"
  name="name"
  required
  maxlength="100"
>

<label for="contact_email">
  Contact Email
</label>

<input
  type="email"
  id="contact_email"
  name="contact_email"
  required
>

<label for="description">
  Description
</label>

<textarea
  id="description"
  name="description"
></textarea>

<label for="location">
  Location
</label>

<input
  type="text"
  id="location"
  name="location"
>

<input
  type="hidden"
  name="image_filename"
  value="default-organization.jfif"
>