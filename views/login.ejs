<%- include("partials/header", { title }) %>

<main class="container">

    <h1>Login</h1>

    <form action="/login" method="POST">

        <label for="email">
            Email
        </label>

        <input
            type="email"
            id="email"
            name="email"
            required
        >

        <label for="password">
            Password
        </label>

        <input
            type="password"
            id="password"
            name="password"
            required
        >

        <button type="submit">
            Login
        </button>

    </form>

    <p>
        Don't have an account?
        <a href="/register">Register here</a>.
    </p>

</main>

<%- include("partials/footer") %>