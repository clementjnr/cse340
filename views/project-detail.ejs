<section class="project-categories">

  <h2>Categories</h2>

  <% if (categories.length > 0) { %>

    <div class="category-tags">

      <% categories.forEach(category => { %>

        <a
          href="/category/<%= category.category_id %>"
          class="category-tag"
        >
          <%= category.name %>
        </a>

      <% }) %>

    </div>

  <% } else { %>

    <p>No categories assigned.</p>

  <% } %>

</section>