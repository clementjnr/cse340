<%- include("partials/header") %>

<main>

  <h1><%= project.title %></h1>

 
    <% if (user && user.role === "admin") { %>
 <p>
    <a href="/edit-project/<%= project.project_id %>">
      Edit Project
    </a>
</p>
<% } %>

  

  <% if (user) { %>
    <section class="volunteer-actions">
      <h2>Volunteer</h2>
      <% if (volunteering) { %>
        <p><strong>You are volunteering for this project.</strong></p>
        <form action="/projects/<%= project.project_id %>/unvolunteer" method="POST">
          <button type="submit">Remove Me as Volunteer</button>
        </form>
      <% } else { %>
        <form action="/projects/<%= project.project_id %>/volunteer" method="POST">
          <button type="submit">Volunteer for This Project</button>
        </form>
      <% } %>
    </section>
  <% } %>

  <section>

    <h2>Project Details</h2>

    <p>
      <strong>Description:</strong>
      <%= project.description || "No description provided." %>
    </p>

    <p>
      <strong>Location:</strong>
      <%= project.location || "No location provided." %>
    </p>

    <p>
      <strong>Date:</strong>
      <%= project.project_date %>
    </p>

    <p>
      <strong>Organization:</strong>
      <a href="/organizations/<%= project.organization_id %>">
        <%= project.organization_name %>
      </a>
    </p>

  </section>

  <section>

    <h2>Categories</h2>

<% if (user && user.role === "admin") { %>

    <p>
        <a href="/assign-categories/<%= project.project_id %>">
            Assign Categories
        </a>
    </p>

<% } %>

    <% if (categories && categories.length > 0) { %>

      <div class="category-tags">

        <% categories.forEach(category => { %>

          <a
            href="/categories/<%= category.category_id %>"
            class="category-tag"
          >
            <%= category.name %>
          </a>

        <% }) %>

      </div>

    <% } else { %>

      <p>
        No categories are assigned to this project.
      </p>

    <% } %>

  </section>

</main>

<%- include("partials/footer") %>