<%- include("partials/header") %>

<main>
  <h1>New Category</h1>

  <form action="/new-category" method="POST">

    <label for="name">
      Category Name
    </label>

    <input
      type="text"
      id="name"
      name="name"
      required
      maxlength="100"
    >

    <button type="submit">
      Create Category
    </button>

    <a href="/categories">
      Cancel
    </a>

  </form>
</main>

<%- include("partials/footer") %>