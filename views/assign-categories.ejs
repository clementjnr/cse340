<%- include("partials/header") %>

<main>

  <h1>Assign Categories</h1>

  <h2>
    Project: <%= project.title %>
  </h2>

  <form
    action="/assign-categories/<%= project.project_id %>"
    method="POST"
  >

    <fieldset>

      <legend>
        Select categories for "<%= project.title %>"
      </legend>

      <% if (categories.length > 0) { %>

        <% categories.forEach(category => { %>

          <div class="category-option">

            <input
              type="checkbox"
              id="category-<%= category.category_id %>"
              name="category_ids"
              value="<%= category.category_id %>"
              <%= assignedCategoryIds.includes(Number(category.category_id))
                ? "checked"
                : "" %>
            >

            <label
              for="category-<%= category.category_id %>"
            >
              <strong>
                <%= category.name %>
              </strong>
            </label>

          </div>

        <% }) %>

      <% } else { %>

        <p>No categories are available.</p>

      <% } %>

    </fieldset>

    <button type="submit">
      Save Categories
    </button>

    <a href="/projects/<%= project.project_id %>">
      Cancel
    </a>

  </form>

</main>

<%- include("partials/footer") %>