<%- include("partials/header") %>

<main>
  <h1>Edit Organization</h1>

  <form
    action="/edit-organization/<%= organization.organization_id %>"
    method="POST"
  >

    <label for="name">
      Organization Name
    </label>

    <input
      type="text"
      id="name"
      name="name"
      value="<%= organization.name %>"
      required
      maxlength="100"
    >

    <label for="contact_email">
      Contact Email
    </label>

    <input
      type="email"
      id="contact_email"
      name="contact_email"
      value="<%= organization.contact_email || "" %>"
      required
    >

    <label for="description">
      Description
    </label>

    <textarea
      id="description"
      name="description"
    ><%= organization.description || "" %></textarea>

    <label for="location">
      Location
    </label>

    <input
      type="text"
      id="location"
      name="location"
      value="<%= organization.location || "" %>"
    >

    <label for="image_filename">
      Organization Image Filename
    </label>

    <input
      type="text"
      id="image_filename"
      name="image_filename"
      value="<%= organization.image_filename || "default-organization.jfif" %>"
      required
    >

    <p>
      Current image:
    </p>

    <img
      src="/images/<%= organization.image_filename || "default-organization.jfif" %>"
      alt="<%= organization.name %>"
      width="200"
    >

    <button type="submit">
      Update Organization
    </button>

    <a href="/organizations/<%= organization.organization_id %>">
      Cancel
    </a>

  </form>
</main>

<%- include("partials/footer") %>