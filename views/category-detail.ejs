<%- include("partials/header") %>

<main>

  <h1><%= category.name %></h1>


    <% if (user && user.role === "admin") { %>
  <p>
    <a href="/edit-category/<%= category.category_id %>">
      Edit Category
    </a>
</p>
<% } %>

  

  <section>

    <h2>Service Projects</h2>

    <% if (projects && projects.length > 0) { %>

      <ul>

        <% projects.forEach(project => { %>

          <li>
            <a href="/projects/<%= project.project_id %>">
              <%= project.title %>
            </a>
          </li>

        <% }) %>

      </ul>

    <% } else { %>

      <p>
        No service projects are assigned to this category.
      </p>

    <% } %>

  </section>

</main>

<%- include("partials/footer") %>