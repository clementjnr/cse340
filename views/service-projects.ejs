<%- include("partials/header", { title }) %>

<section class="page-heading">
    <p class="eyebrow">Volunteer Opportunities</p>

    <h1>Service Projects</h1>

    <p>
        Find projects where you can contribute your time,
        skills, and energy to help others.
    </p>
</section>

<section class="project-list">

    <% if (projects.length > 0) { %>

        <% projects.forEach((project) => { %>

            <article class="project">

                <div class="project-content">

                    <p class="project-date">
                        <%= new Date(project.project_date).toLocaleDateString(
                            "en-US",
                            {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                                timeZone: "UTC"
                            }
                        ) %>
                    </p>

                    <h2>
                        <%= project.title %>
                    </h2>

                    <p>
                        <strong>Organization:</strong>
                        <%= project.organization_name %>
                    </p>

                    <p>
                        <%= project.description %>
                    </p>

                    <p>
                        <strong>Location:</strong>
                        <%= project.location %>
                    </p>

                </div>

            </article>

        <% }) %>

    <% } else { %>

        <p>No service projects are available at this time.</p>

    <% } %>

</section>

<%- include("partials/footer") %>
